<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Our.Umbraco.TrueCopy</PackageId>
    <AssemblyName>Our.Umbraco.TrueCopy</AssemblyName>
    <RootNamespace>Our.Umbraco.TrueCopy</RootNamespace>
    <Product>TrueCopy for Umbraco</Product>
    <Title>TrueCopy for Umbraco</Title>
    <Description>Umbraco's built-in Copy duplicates a subtree but copies property values verbatim, so every Content Picker, Multinode Treepicker, Multi URL Picker and rich-text internal link in the copies still points at the original pages. TrueCopy adds a True Copy action that performs the copy and then repoints every internal link whose target was itself part of the copy. Links pointing outside the copy are left alone but are counted and listed afterwards, because that is the one thing an editor cannot see for themselves. Custom property editors can be supported by implementing ILinkRewriter.</Description>
    <PackageTags>umbraco umbraco-marketplace umbraco-package umbraco-18 backoffice copy duplicate links content-tree</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>



  <!-- Per-project - with versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[18.2.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.2.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.2.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[18.2.0,19.0.0)" />

    <!--
      Microsoft.AspNetCore.OpenApi is available transitively from the Umbraco packages above, but we
      take a direct dependency here because extension code directly uses types from this package
      (IOpenApiDocumentTransformer, IOpenApiOperationTransformer, etc.) and from Microsoft.OpenApi
      (OpenApiInfo). Without a direct reference, this project's Microsoft.AspNetCore.OpenApi version
      is determined solely by NuGet's transitive resolution, which can resolve to a different version
      than the host site project (e.g. a newer patch). When that happens, the different
      Microsoft.OpenApi versions can conflict at runtime, causing custom OpenAPI documents registered
      by the extension to fail to appear.
      Most other transitive dependencies don't have this problem because extension code doesn't use
      their types directly - only Microsoft.AspNetCore.OpenApi / Microsoft.OpenApi types are
      referenced in the composer.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\img\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UDI and JSON helpers are implementation detail, but they carry enough of the risk to be
         worth testing directly. -->
    <InternalsVisibleTo Include="Our.Umbraco.TrueCopy.Tests" />
  </ItemGroup>

  <!--
    wwwroot/ is Vite output and is not committed, so a fresh clone would otherwise build a backend
    with no entity action. Build the client once if the bundle is missing; day-to-day you use
    `npm run watch` in Client/, and this target then stays out of the way.
    Set -p:BuildClient=false to skip it entirely (e.g. on a build agent that builds the client itself).
  -->
  <Target Name="BuildTrueCopyClient" BeforeTargets="BeforeBuild" Condition="'$(BuildClient)' != 'false' AND !Exists('$(MSBuildProjectDirectory)\wwwroot\App_Plugins\TrueCopy\true-copy.js')">
    <Message Text="True Copy client bundle not found - building it with npm." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\Client" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Client" />
  </Target>

</Project>
